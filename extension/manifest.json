{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "MCP Bridge for ProjectionLab",
  "description": "Connects ProjectionLab's Plugin API to a local projectionlab-mcp server.",
  "homepage_url": "https://github.com/Backroads4Me/projectionlab-mcp",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["https://app.projectionlab.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "MCP Bridge for ProjectionLab", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
